#!/usr/bin/env bash

set -euo pipefail

if [[ -n "${NIXPKGS_KNIVES_GROUPS_DIR:-}" ]]; then
  groups_dir="$NIXPKGS_KNIVES_GROUPS_DIR"
else
  verify_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  groups_dir="$verify_dir/groups"
fi

usage() {
  echo "Usage: verify --group GROUP [ARGUMENTS...]"
}

list_groups() {
  local directory

  echo "Available groups:"
  for directory in "$groups_dir"/*; do
    [[ -x "$directory/verify" ]] || continue
    printf '  %s\n' "${directory##*/}"
  done
}

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

if (( $# == 0 )); then
  usage >&2
  list_groups >&2
  exit 2
fi

case "$1" in
  --group)
    (( $# >= 2 )) || die "--group requires a name"
    group="$2"
    shift 2
    ;;
  -h | --help)
    usage
    list_groups
    exit
    ;;
  *)
    die "Expected --group as the first argument"
    ;;
esac

case "$group" in
  */* | "") die "Invalid group name: $group" ;;
esac

group_verifier="$groups_dir/$group/verify"
if [[ ! -x "$group_verifier" ]]; then
  printf 'Unknown verification group: %s\n' "$group" >&2
  list_groups >&2
  exit 2
fi

exec "$group_verifier" "$@"
