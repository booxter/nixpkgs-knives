#!/usr/bin/env bash

set -euo pipefail

if [[ -n "${NIXPKGS_KNIVES_GROUPS_DIR:-}" ]]; then
  groups_dir="$NIXPKGS_KNIVES_GROUPS_DIR"
else
  cut_dir="${BASH_SOURCE[0]%/*}"
  [[ "$cut_dir" != "${BASH_SOURCE[0]}" ]] || cut_dir=.
  cut_dir="$(cd -- "$cut_dir" && pwd)"
  groups_dir="$cut_dir/groups"
fi

usage() {
  echo "Usage: cut --group GROUP [KNIFE | --all | --maniac]"
}

list_groups() {
  local directory

  echo "Available groups:"
  for directory in "$groups_dir"/*; do
    [[ -d "$directory/bin" ]] || continue
    printf '  %s\n' "${directory##*/}"
  done
}

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

if (( $# == 0 )); then
  usage >&2
  list_groups >&2
  exit 2
fi

case "$1" in
  --group)
    (( $# >= 2 )) || die "--group requires a name"
    group="$2"
    shift 2
    ;;
  -h | --help)
    usage
    list_groups
    exit
    ;;
  *)
    die "Expected --group as the first argument"
    ;;
esac

case "$group" in
  */* | "") die "Invalid group name: $group" ;;
esac

knives_dir="$groups_dir/$group/bin"
if [[ ! -d "$knives_dir" ]]; then
  printf 'Unknown knife group: %s\n' "$group" >&2
  list_groups >&2
  exit 2
fi

list_knives() {
  local knife

  for knife in "$knives_dir"/*; do
    [[ -x "$knife" ]] || continue
    printf '%s\n' "${knife##*/}"
  done
}

run_all() {
  local knife

  for knife in "$knives_dir"/*; do
    [[ -x "$knife" ]] || continue
    printf '==> %s\n' "${knife##*/}"
    "$knife"
  done
}

run_maniac() {
  local changed_file iteration

  changed_file=$(mktemp)
  export NIXPKGS_KNIVES_CHANGED_FILE="$changed_file"
  trap 'rm -f "$NIXPKGS_KNIVES_CHANGED_FILE"' EXIT

  for ((iteration = 1; iteration <= 10; iteration++)); do
    rm -f "$changed_file"
    printf 'Iteration %d\n' "$iteration"
    run_all

    if [[ ! -e "$changed_file" ]]; then
      printf 'Converged after %d iteration(s)\n' "$iteration"
      return
    fi
  done

  printf 'Still changing after 10 iterations\n' >&2
  return 1
}

if (( $# == 0 )); then
  list_knives
  exit 0
fi

if [[ "$1" == -h || "$1" == --help ]]; then
  usage
  list_knives
  exit
fi

knife_name="$1"
shift

case "$knife_name" in
  --all)
    (( $# == 0 )) || {
      printf '%s does not accept arguments\n' "$knife_name" >&2
      exit 2
    }
    run_all
    exit
    ;;
  --maniac)
    (( $# == 0 )) || {
      printf '%s does not accept arguments\n' "$knife_name" >&2
      exit 2
    }
    run_maniac
    exit
    ;;
esac

case "$knife_name" in
  */* | "")
    printf 'Invalid knife name: %s\n' "$knife_name" >&2
    exit 2
    ;;
esac

knife="$knives_dir/$knife_name"
if [[ ! -x "$knife" ]]; then
  printf 'Unknown knife: %s\n' "$knife_name" >&2
  exit 2
fi

exec "$knife" "$@"
