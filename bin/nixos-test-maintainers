#!/usr/bin/env bash

set -euo pipefail

knife_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/nixos-test.sh
source "$knife_dir/../lib/nixos-test.sh"

nixos_test_init

is_candidate() {
  nixos_test_matches_rule nixos-test-maintainers "$1"
}

migrate_file() {
  local file="$1"

  nixos_test_add_root_arg "$file" lib
  # Rewrite a selected maintainer first so its final attribute is preserved.
  nixos_test_apply_rule nixos-test-maintainer-member "$file"
  nixos_test_apply_rule nixos-test-maintainers "$file"
  nixos_test_remove_unused_root_pkgs "$file"
}

nixos_test_run is_candidate migrate_file
