#!/usr/bin/env bash

set -euo pipefail

knife_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/nixos-test.sh
source "$knife_dir/../lib/nixos-test.sh"

nixos_test_init

# Match pkgs.lib.maintainers only when pkgs comes from the outer function.
# References below functions that shadow pkgs are left untouched.
root_maintainers_rule='
id: root-maintainers
language: nix
utils:
  pkgs-shadowing-function:
    all:
      - kind: function_expression
      - not:
          inside:
            kind: source_code
            stopBy: neighbor
      - has:
          all:
            - kind: formals
            - has:
                all:
                  - kind: formal
                  - has:
                      all:
                        - kind: identifier
                        - regex: "^pkgs$"
                      stopBy: neighbor
                stopBy: neighbor
          stopBy: neighbor
rule:
  all:
    - pattern: pkgs.lib.maintainers
    - inside:
        all:
          - kind: function_expression
          - inside:
              kind: source_code
              stopBy: neighbor
        stopBy: end
    - not:
        inside:
          matches: pkgs-shadowing-function
          stopBy: end
'

# Rewrite a selected maintainer first so its final attribute is preserved.
# $MAINTAINER is an ast-grep metavariable, not a shell variable.
# shellcheck disable=SC2016
root_maintainer_member_rule='
id: root-maintainer-member
language: nix
utils:
  pkgs-shadowing-function:
    all:
      - kind: function_expression
      - not:
          inside:
            kind: source_code
            stopBy: neighbor
      - has:
          all:
            - kind: formals
            - has:
                all:
                  - kind: formal
                  - has:
                      all:
                        - kind: identifier
                        - regex: "^pkgs$"
                      stopBy: neighbor
                stopBy: neighbor
          stopBy: neighbor
rule:
  all:
    - pattern: "pkgs.lib.maintainers.$MAINTAINER"
    - inside:
        all:
          - kind: function_expression
          - inside:
              kind: source_code
              stopBy: neighbor
        stopBy: end
    - not:
        inside:
          matches: pkgs-shadowing-function
          stopBy: end
fix: "lib.maintainers.$MAINTAINER"
'

# Rewrite the exact selection after selected maintainers.
root_maintainers_fix_rule="${root_maintainers_rule}
fix: lib.maintainers
"

candidates() {
  local file matches

  while IFS= read -r file; do
    matches=$(
      "$ast_grep" scan \
        --inline-rules "$root_maintainers_rule" \
        --json=stream \
        "$file"
    )
    [[ -n "$matches" ]] || continue

    nixos_test_is_named "$file" || continue
    nixos_test_has_expected_root_args "$file" || continue

    printf '%s\n' "$file"
  done < <(nixos_test_root_pkgs_files)
}

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(candidates)

printf 'Found %d candidates\n' "${#files[@]}"
printf '%s\n' "${files[@]}"

if [[ "${#files[@]}" -eq 0 ]]; then
  exit 0
fi

for file in "${files[@]}"; do
  nixos_test_add_root_arg "$file" lib
  nixos_test_apply_rule "$root_maintainer_member_rule" "$file"
  nixos_test_apply_rule "$root_maintainers_fix_rule" "$file"
  nixos_test_remove_unused_root_pkgs "$file"
  nixos_test_parse "$file"
done

nixos_test_finish
