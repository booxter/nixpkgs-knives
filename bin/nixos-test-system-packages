#!/usr/bin/env bash

set -euo pipefail

knife_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/nixos-test.sh
source "$knife_dir/../lib/nixos-test.sh"

nixos_test_init

# Match every pkgs function argument, including nested module arguments. Files
# with more than one are skipped so the rewrite cannot touch a shadowed pkgs.
formal_pkgs_rule='
id: formal-pkgs
language: nix
rule:
  all:
    - kind: identifier
    - regex: "^pkgs$"
    - inside:
        kind: formal
        stopBy: neighbor
'

# environment.systemPackages = with pkgs; [ foo ];
# environment.systemPackages = [ pkgs.foo ];
#
# Skip nested functions that bind config: config.node.pkgs there would refer to
# the node configuration rather than the outer test configuration.
system_packages_rule='
id: system-packages-pkgs
language: nix
utils:
  config-shadowing-function:
    all:
      - kind: function_expression
      - not:
          inside:
            kind: source_code
            stopBy: neighbor
      - has:
          all:
            - kind: formals
            - has:
                all:
                  - kind: formal
                  - has:
                      all:
                        - kind: identifier
                        - regex: "^config$"
                      stopBy: neighbor
                stopBy: neighbor
          stopBy: neighbor
rule:
  all:
    - kind: identifier
    - regex: "^pkgs$"
    - not:
        inside:
          kind: attrpath
          stopBy: neighbor
    - not:
        inside:
          matches: config-shadowing-function
          stopBy: end
    - any:
        - inside:
            all:
              - kind: with_expression
              - inside:
                  kind: binding
                  regex: "(?s)^environment\\.systemPackages\\s*="
                  stopBy: neighbor
            stopBy: end
        - inside:
            all:
              - kind: list_expression
              - inside:
                  kind: binding
                  regex: "(?s)^environment\\.systemPackages\\s*="
                  stopBy: neighbor
            stopBy: end
fix: config.node.pkgs
'

candidates() {
  local file system_matches formal_count

  while IFS= read -r file; do
    system_matches=$(
      "$ast_grep" scan \
        --inline-rules "$system_packages_rule" \
        --json=stream \
        "$file"
    )
    [[ -n "$system_matches" ]] || continue

    formal_count=$(
      "$ast_grep" scan \
        --inline-rules "$formal_pkgs_rule" \
        --json=stream \
        "$file" |
        wc -l |
        tr -d ' '
    )
    [[ "$formal_count" -eq 1 ]] || continue

    nixos_test_is_named "$file" || continue
    nixos_test_has_expected_root_args "$file" || continue

    printf '%s\n' "$file"
  done < <(nixos_test_root_pkgs_files)
}

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(candidates)

printf 'Found %d candidates\n' "${#files[@]}"
printf '%s\n' "${files[@]}"

if [[ "${#files[@]}" -eq 0 ]]; then
  exit 0
fi

for file in "${files[@]}"; do
  nixos_test_add_root_arg "$file" config
  nixos_test_apply_rule "$system_packages_rule" "$file"
  nixos_test_remove_unused_root_pkgs "$file"
  nixos_test_parse "$file"
done

nixos_test_finish
