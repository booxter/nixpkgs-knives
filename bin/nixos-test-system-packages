#!/usr/bin/env bash

set -euo pipefail

knife_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/nixos-test.sh
source "$knife_dir/../lib/nixos-test.sh"

nixos_test_init

is_candidate() {
  local file="$1"
  local formal_count

  nixos_test_matches_rule nixos-test-system-packages-pkgs "$file" || return

  formal_count=$(nixos_test_rule_match_count nixos-test-formal-pkgs "$file")
  [[ "$formal_count" -eq 1 ]]
}

migrate_file() {
  local file="$1"

  nixos_test_add_root_arg "$file" config
  nixos_test_apply_rule nixos-test-system-packages-pkgs "$file"
  nixos_test_remove_unused_root_pkgs "$file"
}

nixos_test_run is_candidate migrate_file
