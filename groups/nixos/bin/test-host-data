#!/usr/bin/env bash

set -euo pipefail

knife_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../../lib/nixos-test.sh
source "$knife_dir/../../../lib/nixos-test.sh"

nixos_test_init

is_candidate() {
  local file="$1"

  nixos_test_is_named "$file" || return
  nixos_test_matches_rule nixos-test-root-open-function "$file" || return
  nixos_test_matches_rule nixos-test-host-data-pkgs "$file"
}

migrate_file() {
  local file="$1"
  local has_custom_args=false

  if ! nixos_test_has_expected_root_args "$file"; then
    has_custom_args=true
  fi

  nixos_test_apply_rule nixos-test-host-data-pkgs "$file"
  if [[ "$has_custom_args" == true ]]; then
    # This may be a legacy function called before runTest. Such callers pass
    # pkgs but do not know about the test module's hostPkgs argument.
    nixos_test_add_root_arg "$file" hostPkgs "hostPkgs ? pkgs"
  else
    nixos_test_reconcile_root_pkgs "$file" hostPkgs
  fi
}

nixos_test_run is_candidate migrate_file
